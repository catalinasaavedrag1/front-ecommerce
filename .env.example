# URL del web-bff-service. Ejemplos:
#   con proxy de Vite en dev:  VITE_BFF_URL=/api/web-bff
#   directo:                   VITE_BFF_URL=http://localhost:3080/api/web-bff
# Vacío o ausente = el front funciona con los datos de ejemplo locales.
VITE_BFF_URL=

# Timeout por request al BFF (ms). Opcional; por defecto 8000.
# VITE_BFF_TIMEOUT_MS=8000
